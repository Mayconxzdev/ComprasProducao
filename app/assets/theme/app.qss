QWidget {
    background: {WINDOW};
    color: {TEXT};
    font-family: "Segoe UI", "Segoe UI Variable Text", "Arial";
    font-size: 13px;
}
/* QLabel não deve pintar o fundo {WINDOW} por cima de cards (#sectionCard, etc.),
   senão aparecem “manchas” mais escuras atrás de cada texto (efeito de protótipo). */
QLabel {
    background: transparent;
}
QMainWindow, QFrame#pageCard {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
}
QScrollArea {
    border: none;
    background: transparent;
}
QLineEdit, QTextEdit, QPlainTextEdit, QListView, QTableView, QTableWidget {
    background: {CARD};
    color: {TEXT};
    alternate-background-color: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 9px;
    padding: 7px;
    selection-background-color: {ACCENT};
    selection-color: #ffffff;
}
QLineEdit {
    min-height: 22px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QListView:focus, QTableView:focus, QTableWidget:focus {
    border: 1px solid {ACCENT};
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: {TEXT_MUTED};
    background: {WINDOW};
}
QListView::item {
    background: {CARD};
    color: {TEXT};
    padding: 6px 8px;
    min-height: 24px;
}
QListView::item:alternate {
    background: {CARD_ALT};
}
QListWidget::item {
    padding: 6px 10px;
    min-height: 28px;
    border-left: 3px solid transparent;
    border-radius: 6px;
    margin: 1px 2px;
}
QListWidget::item:selected {
    background: {ACCENT};
    color: #ffffff;
    border-left-color: {ACCENT};
}
QListWidget::item:hover:!selected {
    background: {CARD_ALT};
    border-left-color: {ACCENT};
}
QTableView {
    gridline-color: {BORDER};
}
QTableView::item {
    background: {CARD};
    color: {TEXT};
}
QTableView::item:alternate {
    background: {CARD_ALT};
    color: {TEXT};
}
QTableView::item:selected, QListView::item:selected, QTableWidget::item:selected {
    background: {ACCENT};
    color: #ffffff;
}
QPushButton {
    background: {CARD_ALT};
    color: {TEXT};
    border: 1px solid {BORDER};
    border-radius: 9px;
    padding: 9px 14px;
    font-weight: 600;
    min-height: 26px;
}
QPushButton:hover {
    border-color: {ACCENT};
    background: {CARD};
}
QPushButton:pressed {
    background: {WINDOW};
}
QPushButton:disabled {
    color: {TEXT_MUTED};
    background: {CARD};
    border-color: {BORDER};
}
QPushButton#accent {
    background: {ACCENT};
    color: #ffffff;
    border: 1px solid {ACCENT};
}
QPushButton#accent:hover {
    background: {ACCENT};
    border: 1px solid {ACCENT};
    opacity: 0.9;
}
/* Mode toggle button — subtle, not prominent */
QPushButton#modeToggle {
    background: transparent;
    color: {TEXT_MUTED};
    border: 1px solid {BORDER};
    border-radius: 7px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 500;
    min-height: 16px;
}
QPushButton#modeToggle:hover {
    color: {TEXT};
    border-color: {ACCENT};
}
QToolButton {
    background: {CARD_ALT};
    color: {TEXT};
    border: 1px solid {BORDER};
    border-radius: 8px;
    padding: 5px 8px;
    font-weight: 700;
    min-height: 22px;
}
QToolButton:hover {
    border-color: {ACCENT};
}
QToolButton#suggestArrow {
    min-width: 34px;
}
/* Section title labels inside cards */
QLabel#sectionTitle {
    color: {TEXT};
    font-weight: 700;
    font-size: 14px;
    padding: 2px 0 6px 0;
    background: transparent;
}
QLabel#muted {
    color: {TEXT_MUTED};
    background: transparent;
}
/* Live "ao vivo" badge */
QLabel#liveBadge {
    color: {SUCCESS};
    font-weight: 600;
    font-size: 12px;
}
/* Subject display pill in preview column */
QLabel#subjectDisplay {
    color: {TEXT};
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 600;
}
QLabel#subjectDisplayEmpty {
    color: {TEXT_MUTED};
    background: {CARD_ALT};
    border: 1px dashed {BORDER};
    border-radius: 8px;
    padding: 6px 12px;
    font-style: italic;
}
/* Section cards (inner panels in input column) */
QFrame#sectionCard {
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 10px;
}
/* Preview panel (right column) */
QFrame#previewPanel {
    background: {CARD};
    border: 1px solid {BORDER};
    border-left: 2px solid {ACCENT};
    border-radius: 0px;
}
/* Horizontal separator lines */
QFrame#hSeparator {
    border: none;
    border-top: 1px solid {BORDER};
    max-height: 1px;
}
/* Preview browser — transparent background so panel bg shows */
QTextBrowser#previewBrowser {
    background: {CARD};
    border: none;
    border-radius: 0px;
    padding: 4px;
}
QHeaderView::section {
    background: {CARD_ALT};
    color: {TEXT};
    border: 0;
    padding: 7px;
    font-weight: 600;
}

/* Passo a passo / dicas longas na coluna de entrada (cotação) */
QLabel#flowSteps {
    color: {TEXT};
    background: transparent;
    border: 1px solid {BORDER};
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 12px;
}

/* Prévia de item estruturado (cotação) */
QLabel#itemPreviewHint {
    color: {TEXT_MUTED};
    background: transparent;
    font-weight: 600;
}
QStatusBar {
    background: {CARD};
    color: {TEXT_MUTED};
    border-top: 1px solid {BORDER};
}
QToolBar#mainToolbar {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 10px;
    spacing: 6px;
    padding: 4px;
}
QToolBar#mainToolbar QToolButton {
    min-height: 28px;
}
QScrollBar:vertical {
    border: none;
    background: {CARD};
    width: 11px;
    margin: 2px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: {CARD_ALT};
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: {ACCENT};
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    border: none;
    background: {CARD};
    height: 11px;
    margin: 2px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: {CARD_ALT};
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background: {ACCENT};
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Botão de tema na barra lateral: visível e discreto (não competir com ações principais) */
QPushButton#sidebarThemeBtn {
    background: {CARD_ALT};
    color: {TEXT};
    border: 1px solid {BORDER};
    border-radius: 9px;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 12px;
    min-height: 28px;
}
QPushButton#sidebarThemeBtn:hover {
    border-color: {ACCENT};
    background: {CARD};
}

/* Smart Composer v2 */
QFrame#composerHeader, QFrame#identityBar, QFrame#sendBar {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
}
QFrame#composerPanel {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
}
QFrame#miniCard {
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 12px;
}
QFrame#transparentFrame {
    background: transparent;
    border: none;
}
QFrame#dropZone {
    background: {CARD_ALT};
    border: 1px dashed {ACCENT};
    border-radius: 12px;
}
QFrame#dropZone:hover {
    background: {CARD};
    border: 1px solid {ACCENT};
}
QTextEdit#smartInput {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
    padding: 10px;
    font-size: 13px;
}
QLabel#detectedPill {
    color: {TEXT};
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 10px;
    padding: 7px 10px;
    font-weight: 600;
}
QLabel#summaryPanel {
    color: {TEXT};
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 10px;
    padding: 8px 10px;
}
QLabel#warningPanel {
    color: {TEXT};
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 10px;
    padding: 8px 10px;
}
QLabel#sendSummary {
    color: {TEXT};
    font-weight: 600;
}
QPushButton#segmentButton, QPushButton#companyPill {
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 10px;
    padding: 8px 12px;
    font-weight: 700;
}
QPushButton#segmentButton:checked, QPushButton#companyPill:checked {
    background: {ACCENT};
    color: #ffffff;
    border: 1px solid {ACCENT};
}
QPushButton#secondarySmall {
    background: {CARD_ALT};
    color: {TEXT};
    border: 1px solid {BORDER};
    border-radius: 9px;
    padding: 6px 10px;
    min-height: 20px;
    font-size: 12px;
}
QSplitter#composerSplitter::handle {
    background: {WINDOW};
    width: 8px;
}
QComboBox {
    background: {CARD_ALT};
    color: {TEXT};
    border: 1px solid {BORDER};
    border-radius: 9px;
    padding: 6px 10px;
    min-height: 24px;
}
QComboBox:focus {
    border: 1px solid {ACCENT};
}

/* Smart Composer v3 — tela operacional única */
QFrame#shellSurface {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 14px;
}
QFrame#hiddenSidebar {
    background: transparent;
    border: none;
}
QFrame#workCanvas {
    background: transparent;
    border: none;
}
QFrame#previewDrawer {
    background: {CARD};
    border: 1px solid {BORDER};
    border-left: 3px solid {ACCENT};
    border-radius: 12px;
}
QFrame#returnBar {
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 10px;
}
QFrame#composerHeader {
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 14px;
}
QFrame#identityBar, QFrame#sendBar {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
}
QTextEdit#smartInput {
    border: 1px solid {BORDER};
    border-radius: 14px;
    padding: 14px;
    font-size: 14px;
}
QTextEdit#smartInput:focus {
    border: 2px solid {ACCENT};
}
QPushButton#accent {
    min-height: 32px;
    border-radius: 11px;
    font-weight: 800;
}

/* Smart Canvas v1.4 — tarefa enxuta, sem redundância e com ação fixa */
QFrame#shellSurface {
    background: {WINDOW};
    border: 1px solid {BORDER};
    border-radius: 14px;
}
QFrame#composerHeader {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 14px;
}
QFrame#identityBar {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
}
QFrame#sendBar {
    background: {CARD};
    border: 1px solid {ACCENT};
    border-radius: 13px;
}
QFrame#miniCard {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 13px;
}
QFrame#composerPanel {
    background: transparent;
    border: none;
}
QLabel#recipientChips {
    color: {TEXT};
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 10px;
    padding: 7px 10px;
    font-weight: 600;
}
QFrame#dropZonePrimary, QFrame#dropZone {
    background: {CARD};
    border: 1px dashed {ACCENT};
    border-radius: 13px;
}
QFrame#dropZonePrimary {
    min-height: 78px;
}
QPushButton#accent {
    min-height: 36px;
    padding: 9px 18px;
    border-radius: 12px;
    font-size: 13px;
}
QPushButton#segmentButton, QPushButton#companyPill {
    padding: 7px 12px;
    min-height: 28px;
}
QTextEdit#smartInput {
    min-height: 132px;
}
QListWidget {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 10px;
}

/* Visual Final v1.5 — referência M3/F3/O3: cards largos, lista única e barra fixa */
QFrame#shellSurface {
    background: {WINDOW};
    border: 1px solid {BORDER};
    border-radius: 16px;
}
QFrame#finalHeader {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 16px;
}
QLabel#brandLogo {
    background: {ACCENT};
    color: #ffffff;
    border-radius: 12px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    font-weight: 900;
    font-size: 18px;
}
QFrame#identityBar {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 16px;
}
QFrame#finalContent, QFrame#modePage {
    background: transparent;
    border: none;
}
QScrollArea#modeScroll {
    background: transparent;
    border: none;
}
QFrame#finalCard {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 16px;
}
QLabel#cardTitle {
    color: {TEXT};
    font-weight: 850;
    font-size: 18px;
    background: transparent;
}
QTextEdit#smartInput {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 14px;
    padding: 14px 16px;
    font-size: 14px;
}
QTextEdit#smartInput:focus {
    border: 2px solid {ACCENT};
}
QLineEdit {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 10px;
    min-height: 29px;
    padding: 7px 10px;
}
QComboBox {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 10px;
    min-height: 30px;
    padding: 7px 10px;
}
QFrame#dropZone, QFrame#dropZonePrimary {
    background: {CARD};
    border: 1px dashed {ACCENT};
    border-radius: 16px;
}
QFrame#dropZone:hover, QFrame#dropZonePrimary:hover {
    background: {CARD_ALT};
    border: 1px solid {ACCENT};
}
QLabel#attachmentFiles {
    color: {TEXT_MUTED};
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 10px;
    padding: 6px 10px;
}
QListWidget#attachmentList {
    background: transparent;
    border: none;
    padding: 0px;
}
QListWidget#attachmentList::item {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}
QFrame#attachmentRow {
    background: {CARD_ALT};
    border: 1px solid {BORDER};
    border-radius: 10px;
}
QLabel#attachmentName {
    color: {TEXT};
    font-size: 12px;
    font-weight: 650;
    background: transparent;
}
QFrame#specInputRow {
    background: transparent;
    border: none;
}
QListWidget#exPanelList {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 14px;
    padding: 4px;
}
QListWidget#exPanelList::item, QListWidget#exTemplateList::item {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}
QListWidget#exTemplateList {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 14px;
    padding: 4px;
}
QFrame#exPanelCard, QFrame#exTemplateRow {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
}
QFrame#exPanelCard:hover, QFrame#exTemplateRow:hover {
    background: {CARD_ALT};
    border-color: {ACCENT};
}
QLabel#exPanelName {
    color: {TEXT};
    font-size: 13px;
    font-weight: 850;
    background: transparent;
}
QLabel#exPanelSpecs {
    color: {TEXT_MUTED};
    font-size: 12px;
    background: transparent;
}
QListWidget#recipientList {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 14px;
    padding: 4px;
}
QListWidget#recipientList::item {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}
QFrame#recipientRow {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
}
QFrame#recipientRow:hover {
    background: {CARD_ALT};
    border-color: {ACCENT};
}
QLabel#recipientName {
    color: {TEXT};
    font-size: 13px;
    font-weight: 800;
}
QLabel#recipientEmail {
    color: {TEXT_MUTED};
    font-size: 12px;
}
QPushButton#iconRemove {
    background: transparent;
    color: {TEXT_MUTED};
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 3px 6px;
    font-size: 18px;
    font-weight: 700;
    min-height: 24px;
}
QPushButton#iconRemove:hover {
    color: #D92D20;
    border-color: #FECACA;
    background: #FFF1F2;
}
QPushButton#segmentButton, QPushButton#companyPill {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
    padding: 8px 16px;
    min-height: 28px;
    font-weight: 800;
}
QPushButton#segmentButton:checked, QPushButton#companyPill:checked {
    background: {ACCENT};
    color: #ffffff;
    border-color: {ACCENT};
}
QPushButton#secondarySmall {
    background: {CARD};
    color: {TEXT};
    border: 1px solid {BORDER};
    border-radius: 10px;
    padding: 7px 12px;
    min-height: 24px;
    font-weight: 700;
}
QPushButton#secondarySmall:hover {
    border-color: {ACCENT};
    color: {ACCENT};
}
QPushButton#secondaryAction {
    background: {CARD};
    color: {ACCENT};
    border: 1px solid {ACCENT};
    border-radius: 14px;
    padding: 10px 18px;
    min-height: 34px;
    font-weight: 850;
}
QFrame#sendBar {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 16px;
}
QLabel#sendSummary {
    color: {TEXT};
    font-weight: 800;
    font-size: 13px;
}
QPushButton#accent {
    background: {ACCENT};
    color: #ffffff;
    border: 1px solid {ACCENT};
    border-radius: 14px;
    padding: 10px 22px;
    min-height: 36px;
    font-size: 14px;
    font-weight: 900;
}
QPushButton#accent:hover {
    background: {ACCENT};
    border-color: {ACCENT};
}
QCheckBox#inlineCheck {
    font-weight: 700;
    color: {TEXT};
}
QTextBrowser#previewBrowser {
    background: {CARD};
    border: 1px solid {BORDER};
    border-radius: 12px;
    padding: 10px;
}

/* Dashboard Pro v1.6 — shell com sidebar única e cards premium */
QWidget#appRoot {
    background: #F6F8FC;
}
QFrame#topBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E5EAF2;
}
QFrame#mainContentSurface {
    background: #F6F8FC;
    border: none;
}
QFrame#sideNav {
    background: #FFFFFF;
    border-right: 1px solid #E5EAF2;
}
QPushButton#sideNavButton {
    background: transparent;
    color: #0F172A;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 11px 14px;
    text-align: left;
    font-size: 15px;
    font-weight: 650;
    min-height: 34px;
}
QPushButton#sideNavButton:hover {
    background: #F3F7FF;
    border-color: #D8E6FF;
    color: #0B63CE;
}
QPushButton#sideNavButton[active="true"] {
    background: #EAF2FF;
    border-color: #D8E6FF;
    color: #0B63CE;
    font-weight: 850;
}
QFrame#tipCard {
    background: #F8FBFF;
    border: 1px solid #D8E6FF;
    border-radius: 16px;
}
QLabel#tipTitle {
    color: #0B63CE;
    font-weight: 850;
    font-size: 14px;
}
QLabel#tipText {
    color: #526174;
    font-size: 13px;
    line-height: 150%;
}
QFrame#topControlWrap {
    background: transparent;
    border: none;
}
QLabel#topControlLabel {
    color: #5D6B82;
    font-size: 12px;
    font-weight: 600;
}
QComboBox#topCombo {
    background: #FFFFFF;
    color: #0F172A;
    border: 1px solid #D8E0EA;
    border-radius: 10px;
    padding: 6px 12px;
    min-width: 160px;
    min-height: 28px;
}
QLabel#statusChip {
    background: #FFFFFF;
    color: #526174;
    border: 1px solid #D8E0EA;
    border-radius: 12px;
    padding: 7px 14px;
    font-weight: 650;
}
QPushButton#topLinkButton, QPushButton#topMoreButton, QPushButton#linkButton {
    background: transparent;
    color: #0B63CE;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 6px 10px;
    font-weight: 750;
}
QPushButton#topLinkButton:hover, QPushButton#topMoreButton:hover, QPushButton#linkButton:hover {
    background: #F3F7FF;
    border-color: #D8E6FF;
}
QFrame#dashboardHero, QFrame#dashboardCard, QFrame#dashboardFooter {
    background: #FFFFFF;
    border: 1px solid #E1E7F0;
    border-radius: 18px;
}
QLabel#heroTitle {
    color: #0F172A;
    font-size: 28px;
    font-weight: 900;
}
QLabel#heroSubtitle, QLabel#pageSubtitle {
    color: #5D6B82;
    font-size: 14px;
}
QLabel#pageTitle {
    color: #0F172A;
    font-size: 28px;
    font-weight: 900;
}
QLabel#dashCardTitle {
    color: #0F172A;
    font-size: 18px;
    font-weight: 850;
}
QFrame#dashAction_blue, QFrame#dashAction_green, QFrame#dashAction_purple, QFrame#dashAction_orange,
QFrame#quoteType_blue, QFrame#quoteType_green, QFrame#quoteType_purple, QFrame#quoteType_orange {
    background: #FFFFFF;
    border: 1px solid #D8E0EA;
    border-radius: 18px;
}
QFrame#dashAction_blue:hover, QFrame#quoteType_blue:hover { border-color: #0B63CE; background: #F8FBFF; }
QFrame#dashAction_green:hover, QFrame#quoteType_green:hover { border-color: #16A34A; background: #F7FFF9; }
QFrame#dashAction_purple:hover, QFrame#quoteType_purple:hover { border-color: #7C3AED; background: #FBF7FF; }
QFrame#dashAction_orange:hover, QFrame#quoteType_orange:hover { border-color: #EA580C; background: #FFF8F3; }
